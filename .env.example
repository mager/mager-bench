# One-key option: a Vercel AI Gateway key runs every family below through
# ai-gateway.vercel.sh (creator-prefixed ids like zai/glm-5.3, unified
# billing). Direct provider keys below win when present.
AI_GATEWAY_API_KEY=your_key_here    # https://vercel.com/ai-gateway → API keys

# Free-tier keys — enough for a full multi-model leaderboard
GROQ_API_KEY=your_key_here          # Llama 3.3/3.1 on Groq free tier
GEMINI_API_KEY=your_key_here        # Gemini Flash free via AI Studio (great free judge)

# Cheap / paid (optional — crowdfund or bring your own)
ANTHROPIC_API_KEY=your_key_here     # Haiku is cheap; Sonnet/Opus are paid
OPENAI_API_KEY=your_key_here        # gpt-4o-mini cheap; gpt-4o paid
ZAI_API_KEY=your_key_here           # GLM 5.3 direct on Z.ai (api.z.ai) — reasoning always on
# GLM Coding Plan keys must use the coding endpoint instead:
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# AI Gateway (optional — one key routes to many models: glm-5.3, sonnet-5, …)
# Get one at vercel.com/[team]/~/ai-gateway — spend shows up under Logs/Usage
AI_GATEWAY_API_KEY=your_key_here

# Arize AX tracing (optional — tracing is skipped if unset)
ARIZE_API_KEY=
ARIZE_SPACE_ID=
